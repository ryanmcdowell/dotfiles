#!/bin/sh

########################################################################
#  Path Configuration
#  https://github.com/ryanmcdowell/dotfiles
#
#  Configures and updates the path.
#
########################################################################

# Path configuration
export PATH="./"
export PATH="/bin:$PATH"
export PATH="/sbin:$PATH"
export PATH="/usr/bin:$PATH"
export PATH="/usr/sbin:$PATH"
export PATH="/usr/local/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"

# Terminal Configuration
export EDITOR=vi

# Retrieve the operating system information.
OS=`uname`

# Set OSX specific aliases.
if [[ "$OS" == 'Darwin' ]]; then
    mkdir -p ~/.bin
    export PATH="~/.bin:$PATH"
    
    # Add Homebrew to the path
    export PATH="/opt/homebrew/bin:$PATH"

    # Resolve the Homebrew prefix dynamically so the overrides below work on
    # both Intel (/usr/local) and Apple Silicon (/opt/homebrew) Macs.
    BREW_PREFIX="$(brew --prefix)"

    # Use the gnu utilities instead of the OSX defaults
    export PATH="$BREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"

    # Python Override Configuration
    export PATH="$BREW_PREFIX/opt/python/libexec/bin:$PATH"

    # Manpath Configuration
    export MANPATH="$BREW_PREFIX/opt/coreutils/libexec/gnuman:$MANPATH"
    export MANPATH="$BREW_PREFIX/share/man:$MANPATH"

    # Java Configuration
    export JAVA_HOME=$(/usr/libexec/java_home)

    # Updates PATH for the Google Cloud SDK.
    source '/opt/homebrew/Caskroom/gcloud-cli/latest/google-cloud-sdk/path.zsh.inc'

    # Enables shell command completion for gcloud.
    source '/opt/homebrew/Caskroom/gcloud-cli/latest/google-cloud-sdk/completion.zsh.inc'

elif [[ "$OS" == 'Linux' ]]; then
    export PATH="$HOME/.jenv/bin:$PATH"
fi

